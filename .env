FLINT_REPO=RecursiveSI/flint-nvfp4-gguf
FLINT_FILE=flint-nvfp4.gguf
FLINT_MODEL_DIR=~/models/RecursiveSI/flint-nvfp4-gguf

IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda13
CONTAINER_NAME=llama-flint

HOST=0.0.0.0
PORT=8005

CTX=262144
PARALLEL=1
N_GPU_LAYERS=all
FAST_ATTN=on
CACHE_K=f16
CACHE_V=f16

TEMP=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0

NVIDIA_LIB_DIR=/usr/lib/aarch64-linux-gnu
NVIDIA_DEVICES="/dev/nvidia0 /dev/nvidiactl /dev/nvidia-uvm /dev/nvidia-modeset"

EXTRA_ARGS=